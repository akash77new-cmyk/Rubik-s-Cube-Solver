# Copy to .env for local development:   cp .env.example .env
# Real environment variables (Render, Docker) always override this file.
# Never commit .env.

# --- App -------------------------------------------------------------------
APP_ENV=development            # development | production
FLASK_SECRET_KEY=              # required in production; any long random string
# CUBE_DATA_DIR=./data         # local runtime files: the SQLite database (tests use a temp folder)

# --- Network ---------------------------------------------------------------
# CUBE_WEB_HOST=127.0.0.1      # production default: 0.0.0.0
# CUBE_WEB_PORT=8000           # falls back to $PORT (set by Render), then 8000
# CUBE_ENGINE_HOST=127.0.0.1
# CUBE_ENGINE_PORT=9999
# CUBE_ALLOWED_ORIGINS=*       # comma-separated Socket.IO origins (tightened in Phase 12)

# --- Dataset (Phase 2) -----------------------------------------------------
# CUBE_DATASET_ENABLED=        # save scans as training data; default: on in development, off in production
# CUBE_DATASET_DIR=./ml/data   # where saved scans go (committed to git)

# --- Database (Phase 3) -----------------------------------------------------
# Not set: a local SQLite file, data/cube.db (nothing to install). Required in production.
# To test against Neon, paste your *dev* branch's connection string (Connection pooling
# off) and keep the quotes. Never put the production string in this file.
# DATABASE_URL='postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# --- AI (Phase 4) -----------------------------------------------------------
# Not set: AI is off and the AI Assistant gives built-in answers (the app still works).
# Get a free key at https://aistudio.google.com (Get API key). Keep it private:
# never paste it into a chat, a commit or a screenshot.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite  # the default; if Google says "not found", try gemini-3.8-flash
# GEMINI_THINKING_LEVEL=       # minimal | low | medium | high; empty = the model's default (3.8 Flash: no minimal)
# AI_REQUESTS_PER_MINUTE=10    # the app's own limits, kept below Gemini's free tier
# AI_REQUESTS_PER_DAY=200      # 0 = never call Gemini
# GEMINI_BASE_URL=             # testing only: send requests to a fake Gemini server
# GEMINI_EMBED_MODEL=gemini-embedding-001  # the RAG coach's embedding model (Phase 7)

# --- Added in later phases (leave commented for now) -----------------------
# JWT_SECRET=                  # Phase 9  - signs login tokens
# CAMERA_MODE=local            # Phase 10 - local | browser
